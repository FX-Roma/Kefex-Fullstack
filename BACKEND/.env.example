# Required server configuration
PORT=3005
NODE_ENV=development
KEFEX=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
JWT_EXPIRES_IN=7d
FRONTEND_ORIGIN=http://localhost:4200

# Optional local Postman-only bypass. Keep false outside local development.
# Requests only use this bypass when they explicitly send X-Dev-Role: user/admin.
POSTMAN_AUTH_BYPASS=false
# These must be different active MongoDB accounts with matching roles.
POSTMAN_DEV_USER_EMAIL=
POSTMAN_DEV_ADMIN_EMAIL=
