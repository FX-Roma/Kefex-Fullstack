    {
      "name": "04 — Publications & Explore",
      "description": "Publicaciones: lectura pública; crear requiere JWT. La actualización debe ser del autor o admin; eliminar exige autorización de admin en la ruta.",
      "item": [
        {
          "name": "List publications",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/publicaciones?page=1&limit=20"
            },
            "description": "Lista publicaciones recientes con paginación. Parámetros opcionales: `page`, `limit` (máximo 50), `categoria`, `q`."
          }
        },
        {
          "name": "Search/filter publications",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/publicaciones?page=1&limit=20&q={{searchTerm}}"
            },
            "description": "Busca por texto y admite `categoria` como query param adicional."
          }
        },
        {
          "name": "Create publication (multipart/form-data)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/publicaciones"
            },
            "description": "Crea una publicación. En Postman Body → form-data: `contenido` (Text), `categoria` (Text), `imagen` (File opcional). No fijes manualmente Content-Type; Postman debe generar el boundary.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{userToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "contenido",
                  "value": "Mi experiencia con este producto en KEFEX.",
                  "type": "text"
                },
                {
                  "key": "categoria",
                  "value": "Tecnología",
                  "type": "text"
                },
                {
                  "key": "imagen",
                  "type": "file",
                  "src": ""
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) { const body=pm.response.json(); if (body.publicacion?._id) pm.collectionVariables.set('publicationId', body.publicacion._id); }",
                  "pm.test('Creación de publicación: status esperado', function () { pm.expect([201,400,401,413]).to.include(pm.response.code); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Get publication by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/publicaciones/{{publicationId}}"
            },
            "description": "Obtiene una publicación por su ObjectId. Completa `publicationId` o crea una publicación antes."
          }
        },
        {
          "name": "Update publication by ID",
          "request": {
            "method": "PUT",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/publicaciones/{{publicationId}}"
            },
            "description": "Edita una publicación propia o como admin. Campos permitidos: contenido, categoria, multimedia.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{userToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"contenido\": \"Contenido actualizado desde Postman.\",\n  \"categoria\": \"Tecnología\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Delete publication by ID (admin route)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/publicaciones/{{publicationId}}"
            },
            "description": "Elimina una publicación. La ruta está protegida por rol admin; usa adminToken. Si el middleware además restringe autoría, verifica esa regla en el controlador.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            }
          }
        }
      ]
    },
