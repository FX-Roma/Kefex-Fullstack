    {
      "name": "06 — Cart",
      "description": "Todas las rutas requieren JWT. El carrito corresponde al usuario autenticado; los endpoints con usuarioId comprueban propiedad o rol admin.",
      "item": [
        {
          "name": "Get current user's cart",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/carrito/{{userId}}"
            },
            "description": "Obtiene o crea el carrito del usuario. `userId` se guarda al iniciar sesión.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{userToken}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Add product to cart",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/carrito/items"
            },
            "description": "Agrega una unidad o la cantidad indicada. El producto debe existir y tener stock.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{userToken}}",
                  "type": "string"
                }
              ]
            },
