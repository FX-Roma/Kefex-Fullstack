  "item": [
    {
      "name": "00 — Server & Health",
      "description": "Comprueba que Express está levantado antes de probar endpoints de negocio.",
      "item": [
        {
          "name": "API root",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/"
            },
            "description": "Confirma que la API responde en la raíz."
          }
        },
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/health"
            },
            "description": "Verifica que el servidor HTTP responde. Esta ruta no garantiza por sí sola que MongoDB esté conectado."
          }
        }
      ]
    },
    {
      "name": "01 — Authentication · USER",
      "description": "Flujo para una cuenta normal. El registro público crea siempre rol `user`; luego el login guarda `userToken` automáticamente.",
      "item": [
        {
          "name": "Register user",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/register"
            },
            "description": "Crea una cuenta normal. Usa un correo nuevo; el backend asigna rol `user` y no acepta elevar privilegios desde el body.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"KEFEX Test User\",\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Registro respondido', function () { pm.expect([201,409]).to.include(pm.response.code); });",
                  "if (pm.response.code === 201) { const body=pm.response.json(); if (body.data?.id) pm.collectionVariables.set('userId', body.data.id); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Login user",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login"
            },
            "description": "Autentica una cuenta con rol `user`. Guarda el JWT en `userToken` y el ID en `userId`.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login de usuario exitoso', function () { pm.response.to.have.status(200); });",
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  if (body.data) pm.collectionVariables.set('userToken', body.data);",
                  "  if (body.user?.id) pm.collectionVariables.set('userId', body.user.id);",
                  "  pm.test('La cuenta tiene rol user', function () { pm.expect(body.user?.rol).to.eql('user'); });",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Login user (Spanish alias)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/inicio-sesion"
            },
            "description": "Alias equivalente de inicio de sesión; utiliza las mismas credenciales de usuario.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login de usuario exitoso', function () { pm.response.to.have.status(200); });",
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  if (body.data) pm.collectionVariables.set('userToken', body.data);",
                  "  if (body.user?.id) pm.collectionVariables.set('userId', body.user.id);",
                  "  pm.test('La cuenta tiene rol user', function () { pm.expect(body.user?.rol).to.eql('user'); });",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "02 — Authentication · ADMIN",
      "description": "El login de admin usa el mismo endpoint, pero requiere una cuenta cuyo rol `admin` ya exista en MongoDB. El registro público nunca crea administradores.",
      "item": [
        {
          "name": "Login admin",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login"
            },
            "description": "Inicia sesión con una cuenta administradora preconfigurada. Guarda el JWT en `adminToken`. Si falla el test de rol, revisa el rol de esa cuenta en la base de datos.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login de administrador exitoso', function () { pm.response.to.have.status(200); });",
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  if (body.data) pm.collectionVariables.set('adminToken', body.data);",
                  "  if (body.user?.id) pm.collectionVariables.set('userId', body.user.id);",
                  "  pm.test('La cuenta tiene rol admin', function () { pm.expect(body.user?.rol).to.eql('admin'); });",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Login admin (Spanish alias)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/inicio-sesion"
            },
            "description": "Alias español para iniciar sesión con la cuenta administradora preexistente.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login de administrador exitoso', function () { pm.response.to.have.status(200); });",
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  if (body.data) pm.collectionVariables.set('adminToken', body.data);",
                  "  if (body.user?.id) pm.collectionVariables.set('userId', body.user.id);",
                  "  pm.test('La cuenta tiene rol admin', function () { pm.expect(body.user?.rol).to.eql('admin'); });",
                  "}"
                ]
              }
            }
          ]
        }
      ]
