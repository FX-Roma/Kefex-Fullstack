# MongoDB Atlas connection string (keep the real value private)
KEFEX=mongodb+srv://<db-user>:<db-password>@<cluster>/<database>?retryWrites=true&w=majority

# Generate a long random secret; minimum 32 characters is enforced at startup
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_EXPIRES_IN=8h
PORT=3005
FRONTEND_ORIGIN=http://localhost:4200

# Only for the one-time initial admin bootstrap command; do not commit real values
ADMIN_NAME=KEFEX Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-unique-password-at-least-12-characters
