    {
      "name": "Auth / Register",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/auth/register",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "register"
          ]
        },
        "description": "Public registration. Role is always USER; never send rol from a client.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"KEFEX Test User\",\n  \"email\": \"{{$guid}}@example.com\",\n  \"password\": \"ChangeMe_12345\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 201) {",
              "  const body = pm.response.json();",
              "  if (body.data?.email) pm.collectionVariables.set('email', body.data.email);",
              "  if (body.data?.id) pm.collectionVariables.set('userId', body.data.id);",
              "}"
            ]
          }
        }
      ]
    },
